------------------------------------------------------------------------------
--  test_idl2lang.gpr -- AUnit test-driver project importing the library
------------------------------------------------------------------------------

with "../idl2lang.gpr";
with "aunit";

project Test_Idl2lang is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("test_idl2lang.adb");

   package Compiler is
      for Switches ("ada") use ("-gnat2022", "-gnatwa");
   end Compiler;

end Test_Idl2lang;