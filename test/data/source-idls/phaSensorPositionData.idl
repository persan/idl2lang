//
// Description : Sensor data from position sensors, i.e. GPS.
//
// External dependencies:
//        com::saabgroup::enterprisebus::generalservices::time v4.0.0
//
//===========================================================================

#include "timeType.idl"
#include "com_saabgroup_enterprisebus.idl"

module com{
  module saabgroup{
    module cms {
      module pha {
	module sensor{
	  module position {
	    // ---------------------------------------------
	    // The version of this IDL file
	    //
	    const string IDL_VERSION = "2.1.0";
	    const string DEFAULT_TOPIC =
	    "com.saabgroup.cms.pha.sensor.position.t_position_sensors";



	    // ----------------------------------------------
	    struct PositionType{
	      com::saabgroup::enterprisebus::RADIAN longitude;
	      com::saabgroup::enterprisebus::RADIAN latitude;
	      com::saabgroup::enterprisebus::METER dilution;
	    }; //@top-level false

	    // ----------------------------------------------
	    struct Position{
	      com::saabgroup::enterprisebus::generalservices::time::TimeType senseTime;
	      short sensor; //@key
	      com::saabgroup::enterprisebus::VALID isValid;
	      PositionType position;
	    };
	  };
	};
      };
    };
  };
};
