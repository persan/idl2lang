module org
{
  module omg
  {
    module ALMAS_Management {

      typedef sequence<org::omg::ALMAS_DataModel::ALMAS_Alert> ALMAS_AlertSet;

      struct ALMAS_Response {
	long long request_id;//@key
	org::omg::ALMAS_DataModel::ALMAS_CallStatus error_code;
      };
      //@top-level true
      //#pragma keylist ALMAS_Response request_id

      // Need a singleton topic for ALMAS_Manager since it has attributes
      //struct ALMAS_Manager {
      //	string SystemID;};
		//#pragma keylist ALMAS_Manager

      struct ALMAS_RaiseAlertFromTemplate {
	long long request_id;//@key
	string ProducerID;
	org::omg::ALMAS_DataModel::ALMAS_TemplateIDType TemplateID; };
      //@top-level true
		//#pragma keylist ALMAS_RaiseAlertFromTemplate request_id

      struct ALMAS_RegisterReceiver {
	long long request_id;//@key
	string ReceiverID;
	string RKType; };
      //@top-level true
		//#pragma keylist ALMAS_RegisterReceiver request_id

      struct ALMAS_UnregisterReceiver {
	long long request_id;//@key
	string ReceiverID; };
      //@top-level true
		//#pragma keylist ALMAS_UnregisterReceiver request_id

      struct ALMAS_RaiseAlertFromOverrides {
	long request_id;//@key
	string ProducerID;
	org::omg::ALMAS_DataModel::ALMAS_TemplateIDType TemplateID;
	org::omg::ALMAS_DataModel::ALMAS_AlertDataAttributesType Attributes;
	boolean CategoryValid;
	boolean PriorityValid;
	boolean StatusValid;
	boolean ScopeValid;
	boolean TomeoutValid;
	boolean ConfirmationRequiredValid;
	boolean SecondaryGroupingValid;
	boolean PersistentValid;
	boolean ReliablyDistributedValid;
	boolean TimeoutActionValid;
	boolean AcknowledgementModelValid;
	boolean StaticMessagesValid;
	boolean DynamicMessagesValid; };
      //@top-level true
		//#pragma keylist ALMAS_RaiseAlertFromOverrides request_id

      struct ALMAS_RaiseAlertFromData {
	long long request_id;//@key
	string ProducerID;
	boolean Inhibited;
	boolean RaiseToAll;
	org::omg::ALMAS_DataModel::ALMAS_AlertDataAttributesType Attributes;
	org::omg::ALMAS_DataModel::ALMAS_AlertDataExtraAttributesTypeSet ExtraAttributes;
	org::omg::ALMAS_DataModel::ALMAS_ReceiverKindTypeSet ReceiverKinds; };
      //@top-level true
		//#pragma keylist ALMAS_RaiseAlertFromData request_id

