//
// Description : Sensor data from bottomRange sensors.
//
// External dependencies:
//        com::saabgroup::enterprisebus::generalservices::time v4.0.0
//
//===========================================================================

#include "timeType.idl"
#include "com_saabgroup_enterprisebus.idl"


module com{ module saabgroup { module cms { module pha {
    module sensor { module bottomRange {

        // ----------------------------------------------
        // The version of this IDL file
        //
        const string IDL_VERSION = "2.1.0";
        const string DEFAULT_TOPIC =
            "com.saabgroup.cms.pha.sensor.bottomRange.t_bottomrange_sensors";

        // ----------------------------------------------
        struct BottomRangeType{
            com::saabgroup::enterprisebus::METER value;
            com::saabgroup::enterprisebus::METER error;
        }; //@top-level false


        // ----------------------------------------------
        struct BottomRange{
            com::saabgroup::enterprisebus::generalservices::time::TimeType senseTime;
            short sensor; //@key
            com::saabgroup::enterprisebus::VALID isValid;
            BottomRangeType bottomRange;
        }; //@top-level true
    }; };
}; }; }; };

