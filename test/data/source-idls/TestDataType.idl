module DDSTEST {
    struct DDSTestNoKeyType {
        long longData;
    };

    struct DDSTestKeyType {
        long longKey; //@key
        long longData;
    }; //@top-level true

    struct DDSTestKeyedStringType {
        string stringKey; //@key
        long longData;
    }; //@top-level true

    struct DDSTestOptimizedMemoryKeyedStringType {
        string stringKey; //@key
        long longData;
    }; //@top-level true

    struct DDSTestOptimizedMemoryUnkeyedStringType {
        string str;
        long longData;
    };
};

