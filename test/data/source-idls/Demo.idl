module com { module saabgroup { module enterprisebus {
  module idldemo {
    //--------------------------------------------------------------------------------
    //
    struct MyStruct {
      long X;
      long Y;
      long Z;
    };
    

    //--------------------------------------------------------------------------------
    //
    enum Variants {Var1, Var2, Var3};


    //--------------------------------------------------------------------------------
    //
    union Demo switch (long) {
    case 0:
      MyStruct aStruct;
      
    case 1:
      boolean aBoolean;

    case 2:
      long aLong;
      
    default:
      double aDouble;

    }; //@top-level true
    
  }; // idldemo
  
}; }; };

  
