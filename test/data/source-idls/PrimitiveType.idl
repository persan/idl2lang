struct PrimitiveType {
    char myChar;
    wchar myWchar;
    octet myOctet;
    short myShort;
    unsigned short myUnsignedShort;
    long myLong;
    unsigned long myUnsignedLong;
    long long myLongLong;
    unsigned long long myUnsignedLongLong;
    float myFloat;
    double myDouble;
    long double myLongDouble;
    boolean myBoolean;
};


