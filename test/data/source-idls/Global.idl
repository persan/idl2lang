    unsigned long m2; //@key            
//    double m3;      //@key    
};

struct KeyStruct_3{
    char     m1;  //@key    
    boolean  m2;  //@key    
    octet    m3;  //@key
};

struct KeyStruct_4{
    wchar     m1;  //@key    
//    long long  m2;  //@key    
//    unsigned long long m3;  //@key
};

struct KeyStruct_5{
//    long double  m1;  //@key    
