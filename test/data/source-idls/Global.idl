module Global_IDL_File {
//Modules
module ModuleA {
    const long Constant_1 = 3 * 4;

    struct BitFieldStruct{
        char bf_1_1;
    }; //@top-level false    

	interface Interface1 {
		void op1(in long param1);
		long op2(in short param2);
	};
//};
// reopen of moduole not supported for now

//module ModuleA{
    const long Constant_2 = Constant_1;
	typedef sequence<Interface1> Intreface1Seq;
};

module ModuleB{
    const long Constant_2 = ModuleA::Constant_1;
    
    struct PrimitiveType {
        short m1;
    };
    
    struct AggregateStruct{
        Global_IDL_File::ModuleA::BitFieldStruct m1;
    }; //@top-level false 
    struct ChildStructure{
        short m1;
        PrimitiveType m2; //@resolve-name false
        PrimitiveType m3;
    }; //@top-level false
    struct ParentStructure{
        ChildStructure m1;
    }; //@top-level false
};

// const long Constant_1 = ModuleA::Constant_1;
const long Size_4 = 2 * 2;
// const long Constant_2 = Constant_1 + ModuleA::Constant_1;
const double Constant_3 = PI + PI2; //@resolve-name false

//Typedefs
typedef short ShortType;
typedef long  LongType;
typedef float FloatType;
typedef unsigned short UShortType;
typedef unsigned long ULongType;
typedef double DoubleType;
typedef char CharType;
typedef boolean BooleanType;
typedef octet OctetType;
typedef wchar WCharType;
typedef long long LongLongType;
typedef unsigned long long ULongLongType;
typedef long double LongDoubleType;
typedef string UnboundedStringType;
typedef string<100> String100Type;
typedef wstring UnboundedWstringType;
typedef wstring<100> Wstring100Type;
typedef sequence<short,4> SeqShort4Type;
typedef sequence<ShortType,4> SeqShortType4Type;
typedef sequence<long double,4> SeqLongDouble4Type;
typedef sequence<LongDoubleType,4> SeqLongDoubleType4Type;
typedef sequence<string,2> SeqStringUnboundedType;
typedef sequence<UnboundedStringType,2> SeqStringTypeUnboundedType;
typedef short ArrShort4Type[4];
typedef short ArrShort2_4Type[2][4];
typedef string<100> ArrString100_4Type[4];
typedef String100Type ArrString100Type4Type[4]; 
typedef String100Type ArrString100Type2_4Type[2][4];
typedef sequence<short,4> SeqShortArr_2_4Type[2];
typedef PrimitiveType PrimitiveType_2; //@resolve-name false

//Enums
typedef enum ColorEnum {
    RED, GREEN, BLUE, YELLOW, ORANGE, BROWN, BLACK, WHITE
} ColorType;

enum DigitEnum { 
    ZERO, 
    ONE, TWO, THREE, 
    FOUR, FIVE, SIX,
    EVEN, EIGHT, NINE
};

typedef DigitEnum DigitType;

typedef struct MemberStruct{
    short sData;    
} MemberStructType;

// Keys
struct KeyStruct_1{
    short     m1;  //@key
    long      m2;  //@key
//    float     m3;  //@key        
};

struct KeyStruct_2{
