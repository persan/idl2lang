};

struct KeyStruct_8{
//    short  m1[2];  //@key        
//    long   m2[2];  //@key
    LongType m1;     //@key
};

//Union with Enum discriminator
union ColorEnumUnion switch (ColorEnum){
    case RED:
        short sData;
    case BLUE:
    case GREEN:
        short sData_2;        
    default:
        long lData;
}; //@top-level true

union DigitEnumUnion switch (DigitEnum){
    case ZERO:
        short sData;
    default:
        long lData;
}; 

//Union with Enum typedef discriminator
union ColorTypeUnion switch (ColorType){
    case RED:
        ShortType sData;
}; 

//Union with boolean
union BooleanUnion switch (boolean){
    case TRUE:
        short sData;
    case FALSE:
        long lData;
}; //@top-level true


