//Bitfields struct
struct BitFieldStruct{
    //Individual bit fields
    char  bf_1_1;
    short separator_1;
    char  bf_1_2;
    short separator_2;
    short bf_1_3;
    short separator_3;
    short bf_1_4;
    short separator_4;
    long  bf_1_5;
    short separator_5;    
    long  bf_1_6;

    //Bit fields groups (with the same type)
    short separator_6;    
    octet  bf_2_1;    
    octet  bf_2_2;            
    short separator_7;    
    unsigned short bf_2_3;            
    unsigned short bf_2_4;    
    short separator_8;    
    unsigned long  bf_2_5;            
    unsigned long  bf_2_6;    
        
    //Bit fields groups
    short separator_9;    
    short bf_3_1;      
    unsigned short bf_3_2;
    long bf_3_3;
    unsigned long bf_3_4;
    char bf_3_5;
    wchar bf_3_6;
    octet bf_3_7;
//    short : 0;       
    long bf_3_8;
    long bf_3_9;  
    short bf_3_10;
    short bf_3_11; 
    short separator_10;       
    short bf_3_12;
    long bf_3_13;    
}; 

